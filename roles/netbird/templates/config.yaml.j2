server:
  listenAddress: ":80"
  exposedAddress: "https://{{ netbird_subdomain }}.{{ server_hostname }}:443"
  stunPorts:
    - {{ netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: {{ netbird_log_level | to_json }}
  logFile: "console"
  authSecret: {{ netbird_runtime_auth_secret | to_json }}
  dataDir: "/var/lib/netbird"
  disableAnonymousMetrics: true
  auth:
    issuer: "https://{{ netbird_subdomain }}.{{ server_hostname }}/oauth2"
    localAuthDisabled: {{ netbird_local_auth_disabled | bool | lower }}
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://{{ netbird_subdomain }}.{{ server_hostname }}/nb-auth"
      - "https://{{ netbird_subdomain }}.{{ server_hostname }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
    dashboardPostLogoutRedirectURIs:
      - "https://{{ netbird_subdomain }}.{{ server_hostname }}/"
  reverseProxy:
    trustedHTTPProxies:
      - "172.18.0.0/16"
    trustedPeers:
      - "172.18.0.0/16"
  store:
    engine: "sqlite"
    encryptionKey: {{ netbird_runtime_store_encryption_key | to_json }}

[Unit]
Description=Home Assistant bridge DHCP and DNS
After=network-online.target pve-firewall.service
Wants=network-online.target
Before=pve-guests.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/home-assistant.conf --pid-file=/run/dnsmasq-home-assistant.pid
Restart=on-failure

[Install]
WantedBy=multi-user.target

http:
  middlewares:
    private-clients:
      ipAllowList:
        sourceRange: {{ homelab_proxy_allowed_networks | to_json }}
    local-shortcut:
      redirectRegex:
        regex: '(?i)^http://([a-z0-9-]+)\.test(:80)?(/.*)$'
        replacement: 'https://${1}.{{ homelab_proxy_domain }}${3}'
  routers:
    local-shortcuts:
      rule: "{% for label in homelab_proxy_shortcut_labels %}{{ ' || ' if not loop.first else '' }}Host(`{{ label }}.test`){% endfor %}"
      entryPoints: [lan-http]
      middlewares: [local-shortcut]
      service: noop@internal
    home-assistant-legacy-http:
      rule: "PathPrefix(`/`)"
      priority: 1
      service: home-assistant
      entryPoints: [lan-http]
    proxmox:
      rule: "Host(`proxmox.{{ homelab_proxy_domain }}`)"
      service: proxmox
      entryPoints: [lan, vpn]
    home-assistant:
      rule: "Host(`ha.{{ homelab_proxy_domain }}`)"
      service: home-assistant
      entryPoints: [lan, vpn]
    immich:
      rule: "Host(`immich.{{ homelab_proxy_domain }}`)"
      service: immich
      entryPoints: [lan, vpn]
{% if homelab_proxy_qwen_url %}
    qwen:
      rule: "Host(`qwen.{{ homelab_proxy_domain }}`)"
      service: qwen
      entryPoints: [lan, vpn]
{% endif %}
{% for name in homelab_proxy_opencode_backends %}
    opencode-{{ name }}:
      rule: "Host(`{{ name }}.{{ homelab_proxy_domain }}`)"
      service: opencode-{{ name }}
      entryPoints: [lan, vpn]
{% endfor %}
  services:
    proxmox:
      loadBalancer:
        serversTransport: proxmox
        servers:
          - url: https://127.0.0.1:8006
    home-assistant:
      loadBalancer:
        servers:
          - url: "{{ homelab_proxy_ha_url }}"
    immich:
      loadBalancer:
        servers:
          - url: "{{ homelab_proxy_immich_url }}"
{% if homelab_proxy_qwen_url %}
    qwen:
      loadBalancer:
        servers:
          - url: "{{ homelab_proxy_qwen_url }}"
{% endif %}
{% for name, url in homelab_proxy_opencode_backends.items() %}
    opencode-{{ name }}:
      loadBalancer:
        servers:
          - url: "{{ url }}"
{% endfor %}
  serversTransports:
    proxmox:
      serverName: "{{ homelab_proxy_proxmox_server_name }}"
      rootCAs:
        - "{{ homelab_proxy_directory }}/proxmox-ca.pem"
tls:
  options:
    default:
      minVersion: VersionTLS12

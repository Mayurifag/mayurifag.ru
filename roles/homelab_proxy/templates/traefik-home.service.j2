[Unit]
Description=Private homelab Traefik proxy
Wants=network-online.target netbird.service
After=network-online.target netbird.service
StartLimitIntervalSec=0

[Service]
User=traefik-home
Group=traefik-home
Environment=CF_DNS_API_TOKEN_FILE={{ homelab_proxy_directory }}/cloudflare-token
ExecStart={{ homelab_proxy_directory }}/traefik --configFile={{ homelab_proxy_directory }}/traefik.yml
Restart=on-failure
RestartSec=5
StateDirectory=traefik-home
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target

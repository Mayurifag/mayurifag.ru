[server]
use-ipv4=yes
use-ipv6=no
allow-interfaces={{ homelab_proxy_lan_interface }},{{ homelab_host_bridge }}

[wide-area]
enable-wide-area=no

[publish]
disable-publishing={{ 'no' if homelab_nas_enabled | default(false) | bool else 'yes' }}
disable-user-service-publishing=yes
publish-addresses=yes
publish-aaaa-on-ipv4=no
publish-hinfo=no
publish-workstation=no
publish-domain=no

[reflector]
enable-reflector=yes
reflect-filters=_hap._tcp.local

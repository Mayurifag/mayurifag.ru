- name: Tech
  key-bind: "2"
  columns:
    - size: full
      widgets:
        - type: videos
          title: Tech
          cache: 1h
          update-interval: 1h
          channels: {{ dynacat_tech_youtube_channels | to_json }}
          collapse-after: 5

        - type: split-column
          max-columns: 2
          widgets:
            - type: rss
              title: 4PDA
              cache: 10m
              update-interval: 15m
              feeds:
                - url: https://4pda.to/feed/
                  title: 4PDA
              limit: 30
              collapse-after: 10

            - type: rss
              title: Gizmochina
              cache: 10m
              update-interval: 15m
              feeds:
                - url: https://www.gizmochina.com/feed/
                  title: Gizmochina
              limit: 30
              collapse-after: 10

            - type: hacker-news
              cache: 30m
              update-interval: 30m
              limit: 30
              collapse-after: 10

            - type: lobsters
              cache: 30m
              update-interval: 30m
              limit: 30
              collapse-after: 10

- name: Home
  key-bind: "1"
  columns:
    - size: small
      widgets:
{% include 'home/weather_air.yml.j2' %}

{% include 'home/left.yml.j2' %}

    - size: full
      widgets:
{% include 'home/main.yml.j2' %}

    - size: small
      widgets:
{% set homelab_links = lookup('ansible.builtin.file', inventory_dir ~ '/files/dynacat-bookmarks.yml') | from_yaml %}
{% if homelab_links %}
        - type: bookmarks
          title: Homelab
          groups:
            - links: {{ homelab_links | to_json }}
{% endif %}

{% include 'home/services.yml.j2' %}

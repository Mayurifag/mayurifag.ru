        - type: custom-api
          title: Exchange hours
          cache: 24h
          update-interval: 24h
          template: |
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; text-align: center;">
              <div data-exchange-clock="NASDAQ" class="color-subdue">
                <div class="size-h6 color-subdue">NASDAQ</div>
                <div class="size-h4" data-exchange-state>...</div>
                <div class="size-h6" style="white-space: nowrap;" data-exchange-detail>loading</div>
              </div>
              <div data-exchange-clock="MOEX" class="color-subdue">
                <div class="size-h6 color-subdue">MOEX</div>
                <div class="size-h4" data-exchange-state>...</div>
                <div class="size-h6" style="white-space: nowrap;" data-exchange-detail>loading</div>
              </div>
            </div>

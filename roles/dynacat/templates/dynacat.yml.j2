server:
  port: 8080
  proxied: true
  assets-path: /app/assets

branding:
  hide-footer: true
  logo-url: /assets/favicon.svg
  favicon-url: /assets/favicon.svg
  app-name: rss
  app-icon-url: /assets/favicon.svg
  app-background-color: "#17151f"

theme:
  background-color: 231 15 21
  primary-color: 265 89 79
  contrast-multiplier: 1.2
  positive-color: 135 94 66
  negative-color: 0 100 67
  disable-picker: true

pages:
{% for page in dynacat_pages %}
  - $include: pages/{{ page }}.yml
{% endfor %}
